# Hostinger / production runtime
NODE_ENV=production
PORT=3000

# First admin account. Replace before production deployment.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_EMAIL=admin@ams.kapitech.id

# Optional persistent data directory outside the deployed source tree.
# Example: /home/USERNAME/.kapitech-ams-data
KAPITECH_DATA_DIR=

# Optional server-side Gemini AI key.
GEMINI_API_KEY=

# Public application URL.
APP_URL=https://ams.kapitech.id

# Browser origins allowed to consume the public CMS and lead submission API.
# Comma-separated; defaults to kapitech.id and www.kapitech.id when omitted.
PUBLIC_SITE_ORIGINS=https://kapitech.id,https://www.kapitech.id

# Frontend A/B test fixture mode. Set true only for an isolated A/B testing environment.
VITE_AB_TEST_DATA=false

# Optional Firebase Authentication bridge.
# Firebase is identity only. PostgreSQL remains the authoritative AMS database and RBAC store.
KAPITECH_FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=kapitech-dashboard
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=kapitech-dashboard

# Relational production datasource
# Keep json for local/development until the full cutover gate passes.
KAPITECH_DATA_SOURCE=postgres
KAPITECH_POSTGRES_URL=
KAPITECH_POSTGRES_SSL=require
KAPITECH_POSTGRES_SSL_REJECT_UNAUTHORIZED=true
KAPITECH_POSTGRES_POOL_MAX=10
KAPITECH_POSTGRES_IDLE_TIMEOUT_MS=10000
KAPITECH_POSTGRES_CONNECTION_TIMEOUT_MS=5000
KAPITECH_POSTGRES_STATEMENT_TIMEOUT_MS=15000

KAPITECH_TELEGRAM_BOT_TOKEN=
KAPITECH_TELEGRAM_CHAT_ID=

# PostgreSQL production backup/DR status contract
# Isolated PostgreSQL database used only for restore rehearsal. Never point this at production.
KAPITECH_POSTGRES_REHEARSAL_URL=

KAPITECH_POSTGRES_BACKUP_PROVIDER=
KAPITECH_POSTGRES_BACKUP_LATEST_AT=
# SHA-256 of the exact latest backup artifact.
KAPITECH_POSTGRES_BACKUP_LATEST_SHA256=
KAPITECH_POSTGRES_BACKUP_RESTORE_VERIFIED_AT=
# SHA-256 of the backup artifact used for the latest restore rehearsal; must match the latest backup hash.
KAPITECH_POSTGRES_BACKUP_RESTORE_BACKUP_SHA256=
KAPITECH_POSTGRES_BACKUP_RPO_MINUTES=15
KAPITECH_POSTGRES_BACKUP_RTO_MINUTES=60
KAPITECH_POSTGRES_BACKUP_RETENTION_DAYS=35

# Relational data reconciliation evidence (required for PostgreSQL production cutover)
# ISO-8601 timestamp of the completed and reviewed PostgreSQL vs legacy-data reconciliation.
KAPITECH_RELATIONAL_RECONCILIATION_VERIFIED_AT=
# SHA-256 of the encrypted JSON source used by the signed reconciliation run.
KAPITECH_RELATIONAL_RECONCILIATION_SOURCE_SHA256=

# Private document durable storage (required for PostgreSQL production cutover)
# Use s3-compatible for AWS S3, Cloudflare R2, MinIO, or another S3-compatible provider.
KAPITECH_DOCUMENT_STORAGE_PROVIDER=
KAPITECH_DOCUMENT_STORAGE_BUCKET=
KAPITECH_DOCUMENT_STORAGE_ENDPOINT=
KAPITECH_DOCUMENT_STORAGE_REGION=auto
KAPITECH_DOCUMENT_STORAGE_ACCESS_KEY_ID=
KAPITECH_DOCUMENT_STORAGE_SECRET_ACCESS_KEY=
KAPITECH_DOCUMENT_STORAGE_SESSION_TOKEN=


# Persistent encrypted storage
KAPITECH_DATA_ENCRYPTION_KEY=
KAPITECH_DB_BACKUP_RETENTION=14
# Optional override. Defaults to <data-dir>/backups
KAPITECH_DB_BACKUP_DIR=

